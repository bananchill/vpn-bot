# ── PostgreSQL ──
POSTGRES_USER=vpnbot
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=vpnbot

# ── VPN Bot ──
BOT_TOKEN=your-telegram-bot-token
PANEL_URL=http://your-panel-host:2053
PANEL_SUB_URL=http://your-panel-host:2096
PANEL_USERNAME=admin
PANEL_PASSWORD=your-panel-password
DEFAULT_INBOUND_ID=1
ENCRYPTION_KEY=your-fernet-key
OWNER_ID=your-telegram-id

# ── Admin Mini App ──
ADMIN_BOT_TOKEN=your-admin-bot-token
FERNET_KEY=your-fernet-key
WEBAPP_URL=https://localhost
# Dev mode: skip Telegram initData check for local browser testing
ADMIN_DEV_MODE=false
ADMIN_DEV_TELEGRAM_ID=123456789

# ── Nginx / SSL ──
# localhost для локали, IP или домен для стенда
SERVER_HOST=localhost

# ── PGAdmin (optional) ──
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
